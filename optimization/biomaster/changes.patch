+    def _execution_evidence(self, step, result):
+        """Expose observed execution and declared outputs to the existing checker."""
+        evidence = {
+            "exit_code": result.returncode,
+            "stdout_tail": result.stdout.decode("utf-8", errors="replace")[-5000:],
+            "stderr_tail": result.stderr.decode("utf-8", errors="replace")[-5000:],
+            "files": [],
+        }
+        filenames = step.get("output_filename", [])
+        if isinstance(filenames, str):
+            filenames = [filenames]
+        for declared in filenames[:12]:
+            if not isinstance(declared, str):
+                continue
+            path = declared.split(":", 1)[0].strip()
+            item = {"path": path, "exists": os.path.isfile(path)}
+            try:
+                if item["exists"]:
+                    item["bytes"] = os.path.getsize(path)
+                    with open(path, "rb") as stream:
+                        head = stream.read(1200)
+                    if b"\x00" not in head:
+                        item["preview"] = head.decode("utf-8", errors="replace")
+            except OSError as exc:
+                item["read_error"] = type(exc).__name__
+            evidence["files"].append(item)
+        return json.dumps(evidence, ensure_ascii=False)
+
